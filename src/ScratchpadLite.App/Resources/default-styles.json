{
  "$comment": "The default paragraph style sheet (Section 6.5). Copied to data/styles.json on first run so it can be edited without touching the .exe. Sizes are points.",
  "styles": [
    {
      "name": "Normal",
      "family": "Calibri",
      "sizePt": 11,
      "spaceAfterPt": 8,
      "lineSpacing": 1.15
    },
    {
      "name": "Title",
      "sizePt": 26,
      "spaceAfterPt": 12
    },
    {
      "name": "Subtitle",
      "sizePt": 15,
      "color": "#666666"
    },
    {
      "name": "Heading 1",
      "sizePt": 20,
