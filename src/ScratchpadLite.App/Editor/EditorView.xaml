<UserControl x:Class="ScratchpadLite.App.Editor.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <!-- Section 6.8. The paper sits centred on a darker surface so it reads as
         a page. Zoom is a LayoutTransform on the paper, which means layout
         reflows and the scrollbars follow it; a RenderTransform would scale the
         pixels and leave the scrollbars wrong.

         The shadow is two offset Borders rather than a DropShadowEffect. An
         Effect forces WPF to allocate a render target the size of the element,
         and the paper is as tall as the whole document - on a long file that is
         a large bitmap re-rendered on every scroll. Two Borders cost nothing. -->

    <Grid Background="{DynamicResource EditorSurfaceBackground}">
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="OnPreviewMouseWheel">

            <Grid x:Name="PaperHost" Margin="20" HorizontalAlignment="Center">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>

                <!-- The shadow. -->
                <Border Background="{DynamicResource PaperShadow}"
                        Margin="3,4,-3,-4"
                        SnapsToDevicePixels="True" />

                <Border x:Name="Paper"
                        Background="{DynamicResource PaperBackground}"
                        BorderBrush="{DynamicResource PaperBorder}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">

                    <RichTextBox x:Name="EditorBox"
                                 AcceptsTab="True"
                                 IsDocumentEnabled="True"
                                 UndoLimit="500"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PaperForeground}"
                                 Padding="0"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnSelectionChanged"
                                 TextChanged="OnTextChanged" />
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
