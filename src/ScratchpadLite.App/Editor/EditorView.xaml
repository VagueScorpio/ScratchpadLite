<UserControl x:Class="ScratchpadLite.App.Editor.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ScratchpadLite.App.UI"
             xmlns:local="clr-namespace:ScratchpadLite.App.Editor"
             Focusable="False">

    <!-- Section 6.8. The paper sits centred on a darker surface so it reads as
         a page. Zoom is a LayoutTransform on the paper, which means layout
         reflows and the scrollbars follow it; a RenderTransform would scale the
         pixels and leave the scrollbars wrong.

         The shadow is two offset Borders rather than a DropShadowEffect. An
         Effect forces WPF to allocate a render target the size of the element,
         and the paper is as tall as the whole document - on a long file that is
         a large bitmap re-rendered on every scroll. Two Borders cost nothing. -->

    <Grid Background="{DynamicResource EditorSurfaceBackground}">
        <ScrollViewer x:Name="Scroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="OnPreviewMouseWheel">

            <Grid x:Name="PaperHost" Margin="20" HorizontalAlignment="Center">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>

                <!-- The shadow. -->
                <Border Background="{DynamicResource PaperShadow}"
                        Margin="3,4,-3,-4"
                        SnapsToDevicePixels="True" />

                <Border x:Name="Paper"
                        Background="{DynamicResource PaperBackground}"
                        BorderBrush="{DynamicResource PaperBorder}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">

                  <Grid>
                    <RichTextBox x:Name="EditorBox"
                                 AcceptsTab="True"
                                 IsDocumentEnabled="True"
                                 UndoLimit="500"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource PaperForeground}"
                                 Padding="0"
                                 HorizontalScrollBarVisibility="Disabled"
                                 VerticalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnSelectionChanged"
                                 TextChanged="OnTextChanged"
                                 PreviewKeyDown="OnPreviewKeyDown"
                                 PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                                 PreviewMouseMove="OnPreviewMouseMove"
                                 MouseLeftButtonDown="OnMouseDownForTables"
                                 MouseLeftButtonUp="OnMouseUpForTables">

                        <!-- Section 6.9 puts the numbering controls and the
                             table actions here, where the thing they act on is
                             under the pointer. Every item is enabled by its
                             command, so the menu greys out what does not apply
                             rather than hiding it and moving everything else
                             around. The commands themselves are bound by
                             MainWindow, which is why this menu can live in the
                             editor without knowing about them. -->
                        <RichTextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Cut" Command="Cut" />
                                <MenuItem Header="Copy" Command="Copy" />
                                <MenuItem Header="Paste" Command="Paste" />
                                <MenuItem Header="Paste as Plain Text"
                                          Command="{x:Static ui:Commands.PastePlainText}" />
                                <Separator />
                                <MenuItem Header="Link..."
                                          Command="{x:Static ui:Commands.InsertLink}" />
                                <MenuItem Header="Edit Link..."
                                          Command="{x:Static ui:Commands.EditLink}" />
                                <MenuItem Header="Open Link"
                                          Command="{x:Static ui:Commands.OpenLink}" />
                                <MenuItem Header="Remove Link"
                                          Command="{x:Static ui:Commands.RemoveLink}" />
                                <Separator />
                                <MenuItem Header="Image Properties..."
                                          Command="{x:Static ui:Commands.ImageProperties}" />
                                <Separator />
                                <MenuItem Header="Restart Numbering"
                                          Command="{x:Static ui:Commands.RestartNumbering}" />
                                <MenuItem Header="Continue Numbering"
                                          Command="{x:Static ui:Commands.ContinueNumbering}" />
                                <Separator />
                                <MenuItem Header="Table">
                                    <MenuItem Header="Insert Row Above"
                                              Command="{x:Static ui:Commands.InsertRowAbove}" />
                                    <MenuItem Header="Insert Row Below"
                                              Command="{x:Static ui:Commands.InsertRowBelow}" />
                                    <MenuItem Header="Insert Column Left"
                                              Command="{x:Static ui:Commands.InsertColumnLeft}" />
                                    <MenuItem Header="Insert Column Right"
                                              Command="{x:Static ui:Commands.InsertColumnRight}" />
                                    <Separator />
                                    <MenuItem Header="Delete Row"
                                              Command="{x:Static ui:Commands.DeleteRow}" />
                                    <MenuItem Header="Delete Column"
                                              Command="{x:Static ui:Commands.DeleteColumn}" />
                                    <MenuItem Header="Delete Table"
                                              Command="{x:Static ui:Commands.DeleteTable}" />
                                    <Separator />
                                    <MenuItem Header="Merge Cells"
                                              Command="{x:Static ui:Commands.MergeCells}" />
                                    <MenuItem Header="Split Cell"
                                              Command="{x:Static ui:Commands.SplitCell}" />
                                    <MenuItem Header="Cell Shading..."
                                              Command="{x:Static ui:Commands.CellShading}" />
                                    <MenuItem Header="Borders On/Off"
                                              Command="{x:Static ui:Commands.ToggleTableBorders}" />
                                </MenuItem>
                            </ContextMenu>
                        </RichTextBox.ContextMenu>
                    </RichTextBox>

                    <!-- The formatting marks sit in the same cell as the text
                         box, so they share its bounds and the rectangles the
                         text pointers report can be drawn as they come. Last
                         in the Grid, so they paint over the text; hit-test
                         invisible, so clicks go through to it. -->
                    <local:FormattingMarks x:Name="Marks" />
                  </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
