<Window x:Class="ScratchpadLite.App.UI.Dialogs.ParagraphDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paragraph"
        SizeToContent="Height"
        Width="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}">

    <!-- Section 8.1, Format, Paragraph. Alignment, indents, spacing and line
         spacing for the paragraphs the selection touches.

         A blank field means "leave it as it is". That is not a shortcut: with
         several paragraphs selected the dialog has to be able to show that
         they disagree, and the only honest thing to put in the box then is
         nothing. Leaving it blank then leaves those paragraphs alone. -->

    <StackPanel Margin="20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Alignment"
                       VerticalAlignment="Center" Margin="0,0,12,0" />

            <ComboBox x:Name="AlignBox" Grid.Column="1">
                <ComboBoxItem Content="Left" />
                <ComboBoxItem Content="Center" />
                <ComboBoxItem Content="Right" />
                <ComboBoxItem Content="Justify" />
            </ComboBox>
        </Grid>

        <TextBlock Text="Indentation (inches)" Margin="0,18,0,8" FontWeight="SemiBold" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Left"
                       VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox x:Name="LeftBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" MaxLength="7" />

            <TextBlock Grid.Row="0" Grid.Column="3" Text="Right"
                       VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox x:Name="RightBox" Grid.Row="0" Grid.Column="4" Margin="0,0,0,8" MaxLength="7" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="First line"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="FirstLineBox" Grid.Row="1" Grid.Column="1" MaxLength="7" />

            <TextBlock Grid.Row="1" Grid.Column="3"
                       Text="negative hangs"
                       Opacity="0.7"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
        </Grid>

        <TextBlock Text="Spacing (points)" Margin="0,18,0,8" FontWeight="SemiBold" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Before"
                       VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox x:Name="BeforeBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" MaxLength="6" />

            <TextBlock Grid.Row="0" Grid.Column="3" Text="After"
                       VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox x:Name="AfterBox" Grid.Row="0" Grid.Column="4" Margin="0,0,0,8" MaxLength="6" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Line spacing"
                       VerticalAlignment="Center" Margin="0,0,8,0" />

            <!-- Editable, so any multiple can be typed rather than only the
                 four in the list. "Automatic" is the font's own line height,
                 which is not the same as a multiple of 1. -->
            <ComboBox x:Name="LineSpacingBox"
                      Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                      IsEditable="True">
                <ComboBoxItem Content="Automatic" />
                <ComboBoxItem Content="1.0" />
                <ComboBoxItem Content="1.15" />
                <ComboBoxItem Content="1.5" />
                <ComboBoxItem Content="2.0" />
            </ComboBox>
        </Grid>

        <TextBlock Text="A blank box leaves that setting as it is."
                   Opacity="0.7" TextWrapping="Wrap" Margin="0,16,0,0" />

        <TextBlock x:Name="Problem"
                   Foreground="#C00000"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OnOk" />

            <Button Content="Cancel"
                    MinWidth="80"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
