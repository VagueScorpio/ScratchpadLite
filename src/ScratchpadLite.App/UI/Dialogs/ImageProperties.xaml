<Window x:Class="ScratchpadLite.App.UI.Dialogs.ImageProperties"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Properties"
        SizeToContent="Height"
        Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}">

    <!-- Section 6.9: width, height and alt text. Sizes are in points, the same
         unit as everything else in this app and in the saved file. -->

    <StackPanel Margin="20">
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Width"
                       VerticalAlignment="Center"
                       Margin="0,0,12,8" />

            <TextBox x:Name="WidthBox"
                     Grid.Row="0" Grid.Column="1"
                     Margin="0,0,6,8"
                     TextChanged="OnWidthChanged" />

            <TextBlock Grid.Row="0" Grid.Column="2"
                       Text="pt"
                       VerticalAlignment="Center"
                       Margin="0,0,0,8" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Height"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />

            <TextBox x:Name="HeightBox"
                     Grid.Row="1" Grid.Column="1"
                     Margin="0,0,6,0"
                     TextChanged="OnHeightChanged" />

            <TextBlock Grid.Row="1" Grid.Column="2"
                       Text="pt"
                       VerticalAlignment="Center" />
        </Grid>

        <CheckBox x:Name="LockBox"
                  Content="Keep the picture's shape"
                  IsChecked="True"
                  Margin="0,0,0,12" />

        <TextBlock Text="Alt text" Margin="0,0,0,4" />

        <TextBox x:Name="AltBox"
                 AcceptsReturn="False"
                 Margin="0,0,0,4" />

        <TextBlock Text="A short description, for anyone reading the document with a screen reader."
                   TextWrapping="Wrap"
                   Opacity="0.75"
                   Margin="0,0,0,8" />

        <TextBlock x:Name="Natural"
                   TextWrapping="Wrap"
                   Opacity="0.75"
                   Margin="0,0,0,8" />

        <TextBlock x:Name="Problem"
                   Foreground="#C00000"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Original Size"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Click="OnOriginalSize" />

            <Button Content="OK"
                    MinWidth="90"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OnOk" />

            <Button Content="Cancel"
                    MinWidth="80"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
