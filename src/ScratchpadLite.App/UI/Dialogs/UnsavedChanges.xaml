<Window x:Class="ScratchpadLite.App.UI.Dialogs.UnsavedChanges"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scratchpad Lite"
        SizeToContent="Height"
        Width="440"
        MaxHeight="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}">

    <!-- Section 6.12: exit asks about every modified document in one dialog,
         not one prompt per tab. -->

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   x:Name="Heading"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">

            <Button Content="Save All"
                    MinWidth="96"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OnSaveAll" />

            <Button Content="Don't Save"
                    MinWidth="96"
                    Margin="0,0,8,0"
                    Click="OnDiscard" />

            <Button Content="Cancel"
                    MinWidth="96"
                    IsCancel="True"
                    Click="OnCancel" />
        </StackPanel>

        <Border BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="1"
                Padding="8,6">

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                <ItemsControl x:Name="Names" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
