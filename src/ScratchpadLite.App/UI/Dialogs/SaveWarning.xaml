<Window x:Class="ScratchpadLite.App.UI.Dialogs.SaveWarning"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save"
        SizeToContent="Height"
        Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}">

    <!-- Section 7.1. It names what this format will drop from THIS document,
         not what the format cannot do in general - a warning that lists things
         the document does not contain teaches people to dismiss it. -->

    <StackPanel Margin="20">
        <TextBlock x:Name="Headline"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,0,0,10" />

        <ItemsControl x:Name="LostList" Margin="12,0,0,12">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <CheckBox x:Name="DoNotWarn"
                  Margin="0,0,0,16"
                  Content="Don't warn me again for this format" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SaveAnywayButton"
                    Content="Save anyway"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OnSaveAnyway" />

            <Button x:Name="SaveAsDocxButton"
                    Content="Save as DOCX instead"
                    MinWidth="150"
                    Margin="0,0,8,0"
                    Click="OnSaveAsDocx" />

            <Button Content="Cancel"
                    MinWidth="80"
                    IsCancel="True"
                    Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
