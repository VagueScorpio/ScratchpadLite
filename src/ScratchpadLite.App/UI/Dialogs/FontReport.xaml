<Window x:Class="ScratchpadLite.App.UI.Dialogs.FontReport"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Font Report"
        Width="860"
        Height="560"
        MinWidth="520"
        MinHeight="320"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}">

    <!-- Section 6.6.7. Every row comes from the font index, which is already in
         memory, so this opens instantly however many fonts there are. -->

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="Summary"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <CheckBox x:Name="ProblemsOnly"
                      DockPanel.Dock="Right"
                      Content="Problems only"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0"
                      Checked="OnFilterChanged"
                      Unchecked="OnFilterChanged" />
        </DockPanel>

        <DataGrid x:Name="Rows"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  RowHeaderWidth="0"
                  Background="Transparent"
                  BorderBrush="{DynamicResource BorderBrushSoft}"
                  BorderThickness="1">

            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding File}" Width="2*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="2*" />
                <DataGridTextColumn Header="Embedding" Binding="{Binding Embedding}" Width="Auto" />
                <DataGridTextColumn Header="What happened" Binding="{Binding Message}" Width="3*" />
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                    <Style.Triggers>
                        <!-- A problem row is dimmed rather than coloured: a red
                             row in a list where half the entries are duplicates
                             reads as alarm when it is only information. -->
                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsIgnorable}" Value="True">
                            <Setter Property="Opacity" Value="0.6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="Hint"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Open Font Folder" MinWidth="130" Margin="0,0,8,0" Click="OnOpenFolder" />
                <Button Content="Copy to Clipboard" MinWidth="130" Margin="0,0,8,0" Click="OnCopy" />
                <Button Content="Close" MinWidth="80" IsCancel="True" IsDefault="True" Click="OnClose" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
