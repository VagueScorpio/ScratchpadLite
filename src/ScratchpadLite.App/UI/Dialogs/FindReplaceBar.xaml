<UserControl x:Class="ScratchpadLite.App.UI.Dialogs.FindReplaceBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnBarKeyDown">

    <!-- Section 6.10: a bar docked under the toolbar rather than a dialog, so
         the document stays visible and the match can be seen where it is. The
         Replace row is collapsed in Find mode, which is what makes Ctrl+F and
         Ctrl+H the same control. -->

    <Border Background="{DynamicResource ChromeBackground}"
            BorderBrush="{DynamicResource BorderBrushSoft}"
            BorderThickness="0,0,0,1"
            Padding="8,6">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Find row. -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Find"
                       MinWidth="56"
                       VerticalAlignment="Center" />

            <TextBox x:Name="FindBox"
                     Grid.Row="0" Grid.Column="1"
                     MinWidth="200"
                     Margin="0,0,8,0"
                     TextChanged="OnFindTextChanged"
                     PreviewKeyDown="OnBoxKeyDown" />

            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                <TextBlock x:Name="CountText"
                           MinWidth="80"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Opacity="0.8" />

                <Button x:Name="PreviousButton"
                        Content="Previous"
                        MinWidth="80"
                        Margin="0,0,4,0"
                        ToolTip="Shift+F3"
                        Click="OnPreviousClick" />

                <Button x:Name="NextButton"
                        Content="Next"
                        MinWidth="80"
                        Margin="0,0,12,0"
                        ToolTip="F3"
                        Click="OnNextClick" />

                <Button x:Name="CloseButton"
                        Content="Close"
                        MinWidth="72"
                        ToolTip="Escape"
                        Click="OnCloseClick" />
            </StackPanel>

            <!-- Replace row: shown by Ctrl+H, hidden by Ctrl+F. -->
            <TextBlock x:Name="ReplaceLabel"
                       Grid.Row="1" Grid.Column="0"
                       Text="Replace"
                       MinWidth="56"
                       Margin="0,6,0,0"
                       VerticalAlignment="Center" />

            <TextBox x:Name="ReplaceBox"
                     Grid.Row="1" Grid.Column="1"
                     MinWidth="200"
                     Margin="0,6,8,0"
                     PreviewKeyDown="OnBoxKeyDown" />

            <StackPanel x:Name="ReplaceButtons"
                        Grid.Row="1" Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="0,6,0,0">

                <Button x:Name="ReplaceButton"
                        Content="Replace"
                        MinWidth="80"
                        Margin="0,0,4,0"
                        Click="OnReplaceClick" />

                <Button x:Name="ReplaceAllButton"
                        Content="Replace All"
                        MinWidth="92"
                        Click="OnReplaceAllClick" />
            </StackPanel>

            <!-- Options and the message line. -->
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Margin="0,6,0,0">

                <CheckBox x:Name="MatchCaseBox"
                          Content="Match case"
                          Margin="0,0,12,0"
                          Click="OnOptionChanged" />

                <CheckBox x:Name="WholeWordBox"
                          Content="Whole word"
                          Margin="0,0,12,0"
                          Click="OnOptionChanged" />

                <CheckBox x:Name="RegexBox"
                          Content="Regular expression"
                          Margin="0,0,12,0"
                          Click="OnOptionChanged" />

                <CheckBox x:Name="AllTabsBox"
                          Content="All open tabs"
                          Margin="0,0,12,0"
                          Click="OnOptionChanged" />

                <TextBlock x:Name="MessageText"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
