<UserControl x:Class="ScratchpadLite.App.UI.StatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Section 6.18. The AutoSave switch is here rather than buried in
         Preferences, because it writes the real file and the user should be able
         to see at a glance whether it is on.

         Counts come from EditorView, which recounts after typing pauses for
         300 ms (Section 2.1) rather than on every keystroke. -->

    <StatusBar>
        <!-- AutoSave, off by default (Section 6.13.2). Enabled in Phase 8. -->
        <CheckBox x:Name="AutoSaveToggle"
                  Content="AutoSave"
                  IsEnabled="False"
                  ToolTip="AutoSave writes the real file. Crash recovery is always on and is separate."
                  VerticalAlignment="Center" />

        <Separator />

        <!-- Temporary messages: font preparation, "Saved 10:42", and so on. -->
        <StatusBarItem>
            <TextBlock x:Name="MessageText" Opacity="0.8" />
        </StatusBarItem>

        <StatusBarItem HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="WordsText" Margin="0,0,12,0" />
                <TextBlock x:Name="CharactersText" Margin="0,0,12,0" />
                <TextBlock x:Name="CaretText" Margin="0,0,12,0" />
                <TextBlock x:Name="FormatText" Margin="0,0,12,0" />
                <TextBlock x:Name="LanguageText" Margin="0,0,12,0" />

                <TextBlock x:Name="ZoomText" Width="42" TextAlignment="Right" Margin="0,0,6,0" />
                <Slider x:Name="ZoomSlider"
                        Width="110"
                        Minimum="0.5"
                        Maximum="4.0"
                        SmallChange="0.1"
                        LargeChange="0.25"
                        TickFrequency="0.25"
                        IsSnapToTickEnabled="False"
                        VerticalAlignment="Center"
                        ToolTip="Zoom (Ctrl+0 resets)" />
            </StackPanel>
        </StatusBarItem>
    </StatusBar>
</UserControl>
