<Window x:Class="ScratchpadLite.App.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Untitled 1 — Scratchpad Lite"
        Height="700"
        Width="1000"
        MinHeight="400"
        MinWidth="600">

    <!-- Phase 0 shell. The menu structure is Section 8.1 in full, so later
         phases wire commands to items that already exist rather than inventing
         the menu as they go. Items that do nothing yet are disabled. -->

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New Tab" InputGestureText="Ctrl+N" IsEnabled="False" />
                <MenuItem Header="Open..." InputGestureText="Ctrl+O" IsEnabled="False" />
                <MenuItem Header="Open Recent" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Save" InputGestureText="Ctrl+S" IsEnabled="False" />
                <MenuItem Header="Save As..." InputGestureText="Ctrl+Shift+S" IsEnabled="False" />
                <MenuItem Header="Save All" IsEnabled="False" />
                <MenuItem Header="AutoSave" IsCheckable="True" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Close Tab" InputGestureText="Ctrl+W" IsEnabled="False" />
                <MenuItem Header="Page Setup..." IsEnabled="False" />
                <MenuItem Header="Print..." InputGestureText="Ctrl+P" IsEnabled="False" />
                <MenuItem Header="Export as PDF..." IsEnabled="False" />
                <MenuItem Header="Recover Documents..." IsEnabled="False" />
                <Separator />
                <MenuItem Header="Exit" Click="OnExitClick" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" InputGestureText="Ctrl+Z" IsEnabled="False" />
                <MenuItem Header="Redo" InputGestureText="Ctrl+Y" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Cut" InputGestureText="Ctrl+X" IsEnabled="False" />
                <MenuItem Header="Copy" InputGestureText="Ctrl+C" IsEnabled="False" />
                <MenuItem Header="Paste" InputGestureText="Ctrl+V" IsEnabled="False" />
                <MenuItem Header="Paste as Plain Text" InputGestureText="Ctrl+Shift+V" IsEnabled="False" />
                <MenuItem Header="Select All" InputGestureText="Ctrl+A" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Find..." InputGestureText="Ctrl+F" IsEnabled="False" />
                <MenuItem Header="Replace..." InputGestureText="Ctrl+H" IsEnabled="False" />
                <MenuItem Header="Find Next" InputGestureText="F3" IsEnabled="False" />
                <MenuItem Header="Find Previous" InputGestureText="Shift+F3" IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="F_ormat">
                <MenuItem Header="Bold" InputGestureText="Ctrl+B" IsEnabled="False" />
                <MenuItem Header="Italic" InputGestureText="Ctrl+I" IsEnabled="False" />
                <MenuItem Header="Underline" IsEnabled="False">
                    <MenuItem Header="Single" InputGestureText="Ctrl+U" />
                    <MenuItem Header="Double" />
                    <MenuItem Header="Dotted" />
                    <MenuItem Header="Dashed" />
                    <MenuItem Header="Wavy" />
                    <MenuItem Header="None" />
                </MenuItem>
                <MenuItem Header="Strikethrough" InputGestureText="Alt+Shift+5" IsEnabled="False" />
                <MenuItem Header="Superscript" InputGestureText="Ctrl+Shift+=" IsEnabled="False" />
                <MenuItem Header="Subscript" InputGestureText="Ctrl+=" IsEnabled="False" />
                <MenuItem Header="Small Caps" IsEnabled="False" />
                <MenuItem Header="Change Case" IsEnabled="False">
                    <MenuItem Header="UPPERCASE" />
                    <MenuItem Header="lowercase" />
                    <MenuItem Header="Title Case" />
                    <MenuItem Header="Sentence case" />
                </MenuItem>
                <Separator />
                <MenuItem Header="Text Color..." IsEnabled="False" />
                <MenuItem Header="Highlight..." IsEnabled="False" />
                <Separator />
                <MenuItem Header="Paragraph Style" IsEnabled="False" />
                <MenuItem Header="Align" IsEnabled="False">
                    <MenuItem Header="Left" InputGestureText="Ctrl+L" />
                    <MenuItem Header="Center" InputGestureText="Ctrl+E" />
                    <MenuItem Header="Right" InputGestureText="Ctrl+R" />
                    <MenuItem Header="Justify" InputGestureText="Ctrl+J" />
                </MenuItem>
                <MenuItem Header="Line Spacing" IsEnabled="False">
                    <MenuItem Header="1.0" />
                    <MenuItem Header="1.15" />
                    <MenuItem Header="1.5" />
                    <MenuItem Header="2.0" />
                    <MenuItem Header="Custom..." />
                </MenuItem>
                <MenuItem Header="Paragraph..." IsEnabled="False" />
                <MenuItem Header="Increase Indent" IsEnabled="False" />
                <MenuItem Header="Decrease Indent" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Clear Formatting" InputGestureText="Ctrl+Space" IsEnabled="False" />
                <MenuItem Header="Format Painter" IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="_Insert">
                <MenuItem Header="Image..." IsEnabled="False" />
                <MenuItem Header="Table..." IsEnabled="False" />
                <MenuItem Header="Link..." InputGestureText="Ctrl+K" IsEnabled="False" />
                <MenuItem Header="Horizontal Line" IsEnabled="False" />
                <MenuItem Header="Page Break" IsEnabled="False" />
                <MenuItem Header="Special Character..." IsEnabled="False" />
                <MenuItem Header="Date and Time" IsEnabled="False" />
            </MenuItem>

            <!-- Enabled only when the caret is inside a table (Section 8.1). -->
            <MenuItem Header="_Table" IsEnabled="False">
                <MenuItem Header="Insert Row Above" />
                <MenuItem Header="Insert Row Below" />
                <MenuItem Header="Insert Column Left" />
                <MenuItem Header="Insert Column Right" />
                <Separator />
                <MenuItem Header="Delete Row" />
                <MenuItem Header="Delete Column" />
                <MenuItem Header="Delete Table" />
                <Separator />
                <MenuItem Header="Merge Cells" />
                <MenuItem Header="Split Cell" />
                <MenuItem Header="Cell Shading..." />
                <MenuItem Header="Borders On/Off" />
            </MenuItem>

            <MenuItem Header="T_ools">
                <MenuItem Header="Spell Check" InputGestureText="F7" IsCheckable="True" IsEnabled="False" />
                <MenuItem Header="Language" IsEnabled="False" />
                <MenuItem Header="Edit User Dictionary..." IsEnabled="False" />
                <MenuItem Header="Word Count..." IsEnabled="False" />
                <Separator />
                <MenuItem Header="Font Report..." IsEnabled="False" />
                <MenuItem Header="Reload Fonts" IsEnabled="False" />
                <MenuItem Header="Open Font Folder" Click="OnOpenFontFolderClick" />
                <Separator />
                <MenuItem Header="Preferences..." IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Theme" IsEnabled="False">
                    <MenuItem Header="Light" />
                    <MenuItem Header="Dark" />
                    <MenuItem Header="Follow Windows" />
                </MenuItem>
                <MenuItem Header="Dark Paper" IsCheckable="True" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Page Width" IsEnabled="False" />
                <MenuItem Header="Full Width" IsEnabled="False" />
                <MenuItem Header="Zoom" IsEnabled="False" />
                <MenuItem Header="Show Formatting Marks" IsCheckable="True" IsEnabled="False" />
                <MenuItem Header="Toolbars" IsEnabled="False" />
                <MenuItem Header="Status Bar" IsCheckable="True" IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="User Guide" IsEnabled="False" />
                <MenuItem Header="Keyboard Shortcuts" IsEnabled="False" />
                <MenuItem Header="Third-Party Licenses" IsEnabled="False" />
                <MenuItem Header="About" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- Section 6.18. The startup time and the font progress live here. -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StartupText" />
            </StatusBarItem>
        </StatusBar>

        <!-- Phase 1 replaces this placeholder with the tab control and
             EditorView (Section 6.8). -->
        <Grid x:Name="EditorHost">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Opacity="0.6"
                       TextWrapping="Wrap"
                       MaxWidth="420"
                       Text="Phase 0 shell. Phase 1 puts the tabbed editor here." />
        </Grid>
    </DockPanel>
</Window>
