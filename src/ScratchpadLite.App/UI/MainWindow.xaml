<Window x:Class="ScratchpadLite.App.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ScratchpadLite.App.UI"
        xmlns:editor="clr-namespace:ScratchpadLite.App.Editor"
        Title="Untitled 1 — Scratchpad Lite"
        Height="700"
        Width="1040"
        MinHeight="400"
        MinWidth="680"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource WindowForeground}">

    <!-- The menu structure is Section 8.1 in full. Items whose phase has not
         arrived are disabled rather than missing, so a later phase enables a
         menu item that already exists in the right place. Every Command here
         comes from Commands.cs, which is the one place shortcuts are defined
         (Section 8.3). -->

    <DockPanel>
        <Menu DockPanel.Dock="Top" x:Name="MainMenu">
            <MenuItem Header="_File">
                <MenuItem Header="New" Command="{x:Static ui:Commands.NewTab}" />
                <MenuItem Header="Open..." Command="{x:Static ui:Commands.Open}" />
                <MenuItem x:Name="OpenRecentMenu" Header="Open Recent" SubmenuOpened="OnOpenRecentOpened" />
                <Separator />
                <MenuItem Header="Save" Command="{x:Static ui:Commands.Save}" />
                <MenuItem Header="Save As..." Command="{x:Static ui:Commands.SaveAs}" />
                <MenuItem Header="Save All" Command="{x:Static ui:Commands.SaveAll}" IsEnabled="False" />
                <MenuItem x:Name="AutoSaveMenuItem" Header="AutoSave" IsCheckable="True" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Close Tab" Command="{x:Static ui:Commands.CloseTab}" IsEnabled="False" />
                <MenuItem Header="Page Setup..." Command="{x:Static ui:Commands.PageSetup}" IsEnabled="False" />
                <MenuItem Header="Print..." Command="{x:Static ui:Commands.Print}" IsEnabled="False" />
                <MenuItem Header="Export as PDF..." Command="{x:Static ui:Commands.ExportPdf}" IsEnabled="False" />
                <MenuItem Header="Recover Documents..." Command="{x:Static ui:Commands.RecoverDocuments}" IsEnabled="False" />
                <Separator />
                <MenuItem Header="Exit" Command="{x:Static ui:Commands.Exit}" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="Undo" Command="Undo" />
                <MenuItem Header="Redo" Command="Redo" />
                <Separator />
                <MenuItem Header="Cut" Command="Cut" />
                <MenuItem Header="Copy" Command="Copy" />
                <MenuItem Header="Paste" Command="Paste" />
                <MenuItem Header="Paste as Plain Text" Command="{x:Static ui:Commands.PastePlainText}" />
                <MenuItem Header="Select All" Command="SelectAll" />
                <Separator />
                <MenuItem Header="Find..." IsEnabled="False" />
                <MenuItem Header="Replace..." IsEnabled="False" />
                <MenuItem Header="Find Next" IsEnabled="False" />
                <MenuItem Header="Find Previous" IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="F_ormat">
                <MenuItem Header="Bold" Command="EditingCommands.ToggleBold" InputGestureText="Ctrl+B" />
                <MenuItem Header="Italic" Command="EditingCommands.ToggleItalic" InputGestureText="Ctrl+I" />
                <MenuItem Header="Underline">
                    <MenuItem Header="Single" Command="{x:Static ui:Commands.SetUnderline}" CommandParameter="Single" InputGestureText="Ctrl+U" />
                    <MenuItem Header="Double" Command="{x:Static ui:Commands.SetUnderline}" CommandParameter="Double" />
                    <MenuItem Header="Dotted" Command="{x:Static ui:Commands.SetUnderline}" CommandParameter="Dotted" />
                    <MenuItem Header="Dashed" Command="{x:Static ui:Commands.SetUnderline}" CommandParameter="Dashed" />
                    <MenuItem Header="Wavy" Command="{x:Static ui:Commands.SetUnderline}" CommandParameter="Wavy" />
                    <Separator />
                    <MenuItem Header="None" Command="{x:Static ui:Commands.SetUnderline}" CommandParameter="None" />
                </MenuItem>
                <MenuItem Header="Strikethrough" Command="{x:Static ui:Commands.Strikethrough}" />
                <MenuItem Header="Superscript" Command="{x:Static ui:Commands.Superscript}" />
                <MenuItem Header="Subscript" Command="{x:Static ui:Commands.Subscript}" />
                <MenuItem Header="Small Caps" Command="{x:Static ui:Commands.SmallCaps}" />
                <MenuItem Header="Change Case">
                    <MenuItem Header="UPPERCASE" Command="{x:Static ui:Commands.ChangeCase}" CommandParameter="Upper" />
                    <MenuItem Header="lowercase" Command="{x:Static ui:Commands.ChangeCase}" CommandParameter="Lower" />
                    <MenuItem Header="Title Case" Command="{x:Static ui:Commands.ChangeCase}" CommandParameter="Title" />
                    <MenuItem Header="Sentence case" Command="{x:Static ui:Commands.ChangeCase}" CommandParameter="Sentence" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="ParagraphStyleMenu" Header="Paragraph Style" />
                <MenuItem Header="Align">
                    <MenuItem Header="Left" Command="EditingCommands.AlignLeft" InputGestureText="Ctrl+L" />
                    <MenuItem Header="Center" Command="EditingCommands.AlignCenter" InputGestureText="Ctrl+E" />
                    <MenuItem Header="Right" Command="EditingCommands.AlignRight" InputGestureText="Ctrl+R" />
                    <MenuItem Header="Justify" Command="EditingCommands.AlignJustify" InputGestureText="Ctrl+J" />
                </MenuItem>
                <MenuItem Header="Line Spacing">
                    <MenuItem Header="1.0" Command="{x:Static ui:Commands.SetLineSpacing}" CommandParameter="1.0" />
                    <MenuItem Header="1.15" Command="{x:Static ui:Commands.SetLineSpacing}" CommandParameter="1.15" />
                    <MenuItem Header="1.5" Command="{x:Static ui:Commands.SetLineSpacing}" CommandParameter="1.5" />
                    <MenuItem Header="2.0" Command="{x:Static ui:Commands.SetLineSpacing}" CommandParameter="2.0" />
                    <Separator />
                    <MenuItem Header="Custom..." Command="{x:Static ui:Commands.ParagraphSettings}" IsEnabled="False" />
                </MenuItem>
                <MenuItem Header="Paragraph..." Command="{x:Static ui:Commands.ParagraphSettings}" IsEnabled="False" />
                <MenuItem Header="Increase Indent" Command="EditingCommands.IncreaseIndentation" />
                <MenuItem Header="Decrease Indent" Command="EditingCommands.DecreaseIndentation" />
                <Separator />
                <MenuItem Header="Clear Formatting" Command="{x:Static ui:Commands.ClearFormatting}" />
                <MenuItem Header="Format Painter" Command="{x:Static ui:Commands.FormatPainter}" />
            </MenuItem>

            <MenuItem Header="_Insert">
                <MenuItem Header="Image..." Command="{x:Static ui:Commands.InsertImage}" IsEnabled="False" />
                <MenuItem Header="Table..." Command="{x:Static ui:Commands.InsertTable}" IsEnabled="False" />
                <MenuItem Header="Link..." Command="{x:Static ui:Commands.InsertLink}" IsEnabled="False" />
                <MenuItem Header="Horizontal Line" Command="{x:Static ui:Commands.InsertHorizontalLine}" IsEnabled="False" />
                <MenuItem Header="Page Break" Command="{x:Static ui:Commands.InsertPageBreak}" IsEnabled="False" />
                <MenuItem Header="Special Character..." Command="{x:Static ui:Commands.InsertSpecialCharacter}" IsEnabled="False" />
                <MenuItem Header="Date and Time" Command="{x:Static ui:Commands.InsertDateAndTime}" />
            </MenuItem>

            <!-- Enabled only when the caret is inside a table (Phase 6). -->
            <MenuItem Header="_Table" IsEnabled="False">
                <MenuItem Header="Insert Row Above" />
                <MenuItem Header="Insert Row Below" />
                <MenuItem Header="Insert Column Left" />
                <MenuItem Header="Insert Column Right" />
                <Separator />
                <MenuItem Header="Delete Row" />
                <MenuItem Header="Delete Column" />
                <MenuItem Header="Delete Table" />
                <Separator />
                <MenuItem Header="Merge Cells" />
                <MenuItem Header="Split Cell" />
                <MenuItem Header="Cell Shading..." />
                <MenuItem Header="Borders On/Off" />
            </MenuItem>

            <MenuItem Header="T_ools">
                <MenuItem x:Name="SpellCheckMenuItem" Header="Spell Check" IsCheckable="True" IsEnabled="False" InputGestureText="F7" />
                <MenuItem Header="Language" IsEnabled="False" />
                <MenuItem Header="Edit User Dictionary..." IsEnabled="False" />
                <MenuItem Header="Word Count..." Command="{x:Static ui:Commands.WordCount}" />
                <Separator />
                <MenuItem Header="Font Report..." Command="{x:Static ui:Commands.FontReport}" />
                <MenuItem Header="Reload Fonts" Command="{x:Static ui:Commands.ReloadFonts}" />
                <MenuItem Header="Open Font Folder" Command="{x:Static ui:Commands.OpenFontFolder}" />
                <Separator />
                <MenuItem Header="Preferences..." Command="{x:Static ui:Commands.Preferences}" IsEnabled="False" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Theme">
                    <MenuItem x:Name="ThemeLightItem" Header="Light" IsCheckable="True"
                              Command="{x:Static ui:Commands.SetTheme}" CommandParameter="Light" />
                    <MenuItem x:Name="ThemeDarkItem" Header="Dark" IsCheckable="True"
                              Command="{x:Static ui:Commands.SetTheme}" CommandParameter="Dark" />
                    <MenuItem x:Name="ThemeFollowItem" Header="Follow Windows" IsCheckable="True"
                              Command="{x:Static ui:Commands.SetTheme}" CommandParameter="FollowWindows" />
                </MenuItem>
                <MenuItem x:Name="DarkPaperItem" Header="Dark Paper" IsCheckable="True"
                          Command="{x:Static ui:Commands.ToggleDarkPaper}" />
                <Separator />
                <MenuItem x:Name="PageWidthItem" Header="Page Width" IsCheckable="True"
                          Command="{x:Static ui:Commands.SetPageView}" CommandParameter="PageWidth" />
                <MenuItem x:Name="FullWidthItem" Header="Full Width" IsCheckable="True"
                          Command="{x:Static ui:Commands.SetPageView}" CommandParameter="FullWidth" />
                <MenuItem Header="Zoom">
                    <MenuItem Header="50%" Command="{x:Static ui:Commands.SetZoom}" CommandParameter="0.5" />
                    <MenuItem Header="75%" Command="{x:Static ui:Commands.SetZoom}" CommandParameter="0.75" />
                    <MenuItem Header="100%" Command="{x:Static ui:Commands.ResetZoom}" InputGestureText="Ctrl+0" />
                    <MenuItem Header="150%" Command="{x:Static ui:Commands.SetZoom}" CommandParameter="1.5" />
                    <MenuItem Header="200%" Command="{x:Static ui:Commands.SetZoom}" CommandParameter="2.0" />
                    <MenuItem Header="400%" Command="{x:Static ui:Commands.SetZoom}" CommandParameter="4.0" />
                </MenuItem>
                <!-- WPF has no way to draw pilcrows and space dots in a
                     RichTextBox; this needs a custom adorner, which is noted in
                     the Phase 1 report rather than half-built here. -->
                <MenuItem x:Name="FormattingMarksItem" Header="Show Formatting Marks"
                          IsCheckable="True" IsEnabled="False"
                          ToolTip="Not built yet: WPF cannot draw formatting marks without a custom adorner." />
                <MenuItem Header="Toolbars">
                    <MenuItem x:Name="ToolbarRow1Item" Header="Formatting row 1" IsCheckable="True" IsChecked="True" />
                    <MenuItem x:Name="ToolbarRow2Item" Header="Formatting row 2" IsCheckable="True" IsChecked="True" />
                </MenuItem>
                <MenuItem x:Name="StatusBarItemToggle" Header="Status Bar" IsCheckable="True" IsChecked="True"
                          Command="{x:Static ui:Commands.ToggleStatusBar}" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="User Guide" Command="{x:Static ui:Commands.UserGuide}" />
                <MenuItem Header="Keyboard Shortcuts" Command="{x:Static ui:Commands.KeyboardShortcuts}" />
                <MenuItem Header="Third-Party Licenses" Command="{x:Static ui:Commands.ThirdPartyLicenses}" />
                <MenuItem Header="About" Command="{x:Static ui:Commands.About}" />
            </MenuItem>
        </Menu>

        <ui:Toolbars x:Name="FormatToolbars" DockPanel.Dock="Top" />

        <ui:StatusBar x:Name="Status" DockPanel.Dock="Bottom" />

        <!-- Warnings from opening a file (Section 4.4): what the format could
             not carry, an encoding that had to be guessed, an image that could
             not be read. Dismissable, because they are information rather than
             a problem to fix. -->
        <Border x:Name="OpenWarningsBar"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Padding="10,6"
                Background="{DynamicResource ChromeBackground}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Dismiss"
                        MinWidth="72"
                        Margin="8,0,0,0"
                        Click="OnDismissOpenWarnings" />

                <TextBlock x:Name="OpenWarningsText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- The missing-font bar (Section 6.6). It sits above the editor rather
             than in a dialog, because it is information about the document you
             are looking at, not something to dismiss before you can work. It
             has no trigger until documents can be opened in Phase 4; the list
             it shows comes from FontRegistry.MissingFrom. -->
        <Border x:Name="MissingFontsBar"
                DockPanel.Dock="Top"
                Visibility="Collapsed"
                Padding="10,6"
                Background="{DynamicResource ChromeBackground}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Dismiss"
                        MinWidth="72"
                        Margin="8,0,0,0"
                        Click="OnDismissMissingFonts" />

                <Button DockPanel.Dock="Right"
                        Content="Reload Fonts"
                        MinWidth="96"
                        Margin="8,0,0,0"
                        Command="{x:Static ui:Commands.ReloadFonts}" />

                <TextBlock x:Name="MissingFontsText"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Phase 7 replaces this single editor with the tab control. -->
        <editor:EditorView x:Name="Editor" />
    </DockPanel>
</Window>
