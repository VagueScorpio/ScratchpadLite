<UserControl x:Class="ScratchpadLite.App.UI.Controls.StylePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Section 6.5. Each style is drawn in its own formatting, so the list
         shows what it will do rather than just naming it. The preview size is
         capped in code: Title at its real 26 pt would make the dropdown huge. -->

    <ComboBox x:Name="Box"
              Width="132"
              ToolTip="Paragraph style"
              SelectionChanged="OnSelectionChanged">
        <ComboBox.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Name}"
                           FontFamily="{Binding PreviewFamily}"
                           FontSize="{Binding PreviewSizeDip}"
                           FontWeight="{Binding PreviewWeight}"
                           FontStyle="{Binding PreviewStyle}"
                           TextTrimming="CharacterEllipsis" />
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
