<UserControl x:Class="ScratchpadLite.App.UI.Controls.FontPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Section 6.7. Virtualization with recycling is not optional here: with a
         font bundle there can be many hundreds of families, and each name drawn
         in its own font makes WPF open that font file the first time its row is
         shown. Without virtualization the dropdown takes seconds to open.

         Phase 1 lists the Windows fonts. Phase 2 adds the "Font folder" and
         "Recently used" groups, the name-drawn-in-its-own-font setting, and the
         italic-with-warning-glyph row for a font the document asked for but
         this PC does not have. -->

    <ComboBox x:Name="Box"
              Width="178"
              IsEditable="True"
              IsTextSearchEnabled="False"
              ToolTip="Font"
              DropDownOpened="OnDropDownOpened"
              PreviewKeyDown="OnPreviewKeyDown"
              LostFocus="OnLostFocus"
              SelectionChanged="OnSelectionChanged">

        <ComboBox.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.VirtualizationMode="Recycling"
                                        VirtualizingPanel.IsVirtualizingWhenGrouping="True" />
            </ItemsPanelTemplate>
        </ComboBox.ItemsPanel>

        <ComboBox.ItemTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Name}"
                           FontFamily="{Binding PreviewFamily}"
                           FontSize="14"
                           TextTrimming="CharacterEllipsis" />
            </DataTemplate>
        </ComboBox.ItemTemplate>
    </ComboBox>
</UserControl>
