<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0 on purpose: the compiler then enforces the Section 4.2
         dependency rule that Core never references WPF. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ScratchpadLite.Core</RootNamespace>
    <AssemblyName>ScratchpadLite.Core</AssemblyName>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both files live in App\Resources, where Section 5.1 puts them, but Core
         is what reads them, and embedding is what gets them inside the
         single-file .exe. LogicalName is set explicitly so the resource name
         does not depend on how the link path is spelled. -->

    <!-- The default paragraph style sheet (Section 6.5). Copied to
         data\styles.json on first run so the user can edit it. -->
    <EmbeddedResource Include="..\ScratchpadLite.App\Resources\default-styles.json"
                      LogicalName="ScratchpadLite.Core.default-styles.json" />

    <!-- Adobe Glyph List, used by the Type 1 converter (Section 6.6.4). -->
    <EmbeddedResource Include="..\ScratchpadLite.App\Resources\glyphlist.txt"
                      LogicalName="ScratchpadLite.Core.glyphlist.txt"
                      Condition="Exists('..\ScratchpadLite.App\Resources\glyphlist.txt')" />
  </ItemGroup>

  <!-- Packages are added per phase, never up front (Section 2.1 "lean code rules"):
         Phase 4: DocumentFormat.OpenXml (MIT)                  - DOCX
         Phase 5: Markdig (BSD-2)                               - Markdown reading
         Phase 7: System.Text.Encoding.CodePages (MIT)          - Windows-1252 TXT
       Record each one in THIRD_PARTY_LICENSES.txt when it is added. -->

</Project>
